{
  "name": "climberbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:postgres:experimental": "node --test tests/experimental-postgres-api.test.mjs",
    "db:migrate": "docker compose run --rm liquibase",
    "db:rollback:last": "docker compose --profile migration run --rm liquibase rollbackCount 1",
    "db:status": "docker compose --profile migration run --rm liquibase status --verbose"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jose": "^6.2.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "next": "^15.0.0",
    "next-auth": "^4.24.15",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.0.0",
    "sass": "^1.80.7",
    "typescript": "^5.7.2"
  }
}
