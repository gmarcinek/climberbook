{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["./components/alternating-care/source/components/*"],
      "@modules/*": ["./components/alternating-care/source/modules/*"],
      "@utils/*": ["./components/alternating-care/source/utils/*"],
      "@assets/*": ["./components/alternating-care/source/assets/*"],
      "@app/*": ["./components/alternating-care/source/app/*"],
      "@api/*": ["./components/alternating-care/source/api/*"],
      "@styles/*": ["./components/alternating-care/source/styles/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
