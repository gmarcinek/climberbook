# Local Docker Compose and Liquibase access to Azure PostgreSQL only.
# Production App Service uses its own application settings and secrets.
CLIMBERBOOK_ENV=local+azure
POSTGRES_HOST=<server-name>.postgres.database.azure.com
POSTGRES_DOCKER_HOST=<server-name>.postgres.database.azure.com
POSTGRES_DOCKER_PORT=5432
POSTGRES_DB=climberbook
POSTGRES_USER=<admin-login>
POSTGRES_PASSWORD=<password>
POSTGRES_SSLMODE=require
LIQUIBASE_SSLMODE=require